{
  "manifest_version": 3,
  "name": "Profit Calculator — Etsy & Shopify",
  "version": "1.0.0",
  "description": "Calculate profit, margin, and break-even on Etsy and Shopify product edit pages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://*.etsy.com/*",
    "https://admin.shopify.com/*",
    "https://*.myshopify.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Profit Calculator Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/your/shops/*/listing/*",
        "https://www.etsy.com/your/listings/*",
        "https://www.etsy.com/your/shops/me/listing-editor*",
        "https://admin.shopify.com/store/*/products/*",
        "https://*.myshopify.com/admin/products/*"
      ],
      "js": ["src/content/overlay.tsx"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}