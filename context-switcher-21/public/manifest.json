{
  "manifest_version": 3,
  "name": "Context Switcher",
  "version": "0.1.0",
  "description": "Save and restore project tab states with notes and checklists for multi-project freelancers.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Context Switcher",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Context Switcher popup"
    }
  }
}